MINERU_API_TOKEN=
EMBEDDING_BASE_URL=https://example.com/compatible-mode/v1
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_PROFILES_JSON=[{"id":"real-embedding-1024","name":"DashScope Embedding 1024","baseUrl":"https://example.com/compatible-mode/v1","apiKey":"${EMBEDDING_API_KEY}","model":"qwen3.7-text-embedding","dimensions":1024,"maxTokens":4096,"timeoutMs":60000}]
CONTEXT_BASE_URL=https://example.com/compatible-mode/v1
CONTEXT_MODEL=
CONTEXT_API_KEY=
CONTEXT_TIMEOUT_MS=30000
DASHSCOPE_VLM_API_KEY=
# Profile secrets reference the matching capability credential without copying its value.
MODEL_PROFILES_JSON=[{"id":"dashscope-context","name":"DashScope Context","capabilities":["context"],"baseUrl":"https://dashscope.aliyuncs.com/compatible-mode/v1","apiKey":"${CONTEXT_API_KEY}","model":"qwen3.7-flash-2026-07-15","timeoutMs":30000},{"id":"dashscope-vlm","name":"DashScope Qwen3.8 Max VLM","capabilities":["vlm"],"baseUrl":"https://dashscope.aliyuncs.com/compatible-mode/v1","apiKey":"${DASHSCOPE_VLM_API_KEY}","model":"qwen3.8-max","timeoutMs":120000}]
# Local PostgreSQL compose credentials (set values outside source control).
RAG_PG_USER=
RAG_PG_PASSWORD=
RAG_PG_DATABASE=
DATABASE_PROFILES_JSON=[{"id":"local-pgvector","name":"本地 PostgreSQL + pgvector","kind":"pgvector","host":"127.0.0.1","port":54329,"databaseEnv":"RAG_PG_DATABASE","userEnv":"RAG_PG_USER","passwordEnv":"RAG_PG_PASSWORD"}]
# Local acceptance fallback only. Production startup rejects this value when enabled.
RAG_LOCAL_MEMORY_DATABASE=0
# New production-like profiles explicitly select 2.0 after observing the real model dimension.
# DATABASE_PROFILES_JSON=[{"id":"local-pgvector-v2","targetId":"chunk-lab","dimensions":1024,"name":"本地 PostgreSQL + pgvector v2","kind":"pgvector","schemaVersion":"2.0","host":"127.0.0.1","port":54329,"databaseEnv":"RAG_PG_DATABASE","userEnv":"RAG_PG_USER","passwordEnv":"RAG_PG_PASSWORD"}]
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=rag-image-assets
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Production default is 24 hours; zero is allowed only for a dedicated acceptance prefix.
OBJECT_DELETE_GRACE_MS=86400000
PORT=4180
# Optional cross-service retrieval workbench URL (pure new-tab navigation)
AGENTIC_RETRIEVAL_UI_URL=http://127.0.0.1:8090/
